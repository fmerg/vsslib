{
  "compilerOptions": {
    "target": "es2020",
    "types": [],
    "module": "commonjs",
    "rootDir": "./src",
    "paths": {
      "vsslib/*": ["./src/*"],
      "vsslib": ["./src"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "allowJs": false,
    "declaration": true,
    "stripInternal": true,
    "outDir": "./dist"
  },
  "include": ["src"]
}
