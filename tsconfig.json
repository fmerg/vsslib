{
  "compilerOptions": {
    "target": "es2020",
    "types": ["node", "jest"],
    "module": "commonjs",
    "rootDir": "./src",
    "paths": {
      "vsslib/*": ["./src/*"],
      "vsslib": ["./src"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "allowJs": false,
    "declaration": true,
    "outDir": "./dist"
  },
  "exclude": [
    "node_modules",
    "tests",
    "examples",
    "bench",
    "**/*.spec.ts",
    "./dist"
  ]
}
