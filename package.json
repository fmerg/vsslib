{
  "name": "vsslib",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "default": "./dist/backend/index.js"
    },
    "./nizk": {
      "types": "./dist/nizk.d.ts",
      "default": "./dist/nizk.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "backend": [
        "dist/backend/index.d.ts"
      ],
      "nizk": [
        "dist/nizk.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsc --watch",
    "test": "jest tests --maxWorkers=1",
    "test:watch": "jest tests --watch --maxWorkers=1",
    "build": "rm -rf ./dist && tsc",
    "docs": "typedoc --out docs src/*.ts",
    "lint": "eslint src tests bench examples",
    "typecheck": "tsc --noEmit && tsc -p tests && tsc -p bench && tsc -p examples",
    "bench": "./bench.sh",
    "run-publish": "node ./scripts/publish.mjs"
  },
  "author": "",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "commander": "^15.0.0",
    "eslint": "^10.13.0",
    "inquirer": "^14.2.3",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "tinybench": "^6.2.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0"
  }
}
